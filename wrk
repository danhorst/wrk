#!/usr/bin/env bash
set -euo pipefail

VERSION="2.0.0"

PROJECT_ROOT="${WRK_PROJECT_ROOT:-$HOME/git}"
WORKTREE_ROOT="${WRK_WORKTREE_ROOT:-$HOME/.wrk/worktrees}"
VAULT_MARKER="${WRK_VAULT_MARKER:-.wrk-vault}"
# aoe validates --cmd against its agent allowlist, so a plain shell has to be
# reached through a custom agent the user declares in aoe's config.toml.
AOE_SHELL_TOOL="${WRK_AOE_SHELL_TOOL:-shell}"
SSH_AUTH_SOCK_LINK="$(dirname "$WORKTREE_ROOT")/ssh-auth-sock"

show_help() {
  cat <<'EOF'
wrk — tmux session manager for git projects

Usage:
  wrk [query]            Fuzzy-select a project (query pre-fills the search)
  wrk <project> <label>  Open or create a labeled sub-project session
  wrk --list             List all worktrees and their status
  wrk --clean            Review and remove worktrees for merged branches
  wrk --version          Show version
  wrk --help             Show this help

Hotkeys (in the project picker):
  ctrl-o                 Open a branch picker for the highlighted project;
                         creates a worktree-backed session for the chosen branch
  ctrl-t                 Open a named session for the highlighted project
                         in the same directory (no worktree)
  ctrl-x                 Switch to a picker of all live sessions

Hotkeys (in the session pickers):
  ctrl-d                 Terminate the highlighted session, after a prompt.
                         Under aoe the record goes to aoe's trash and is
                         restorable with `aoe session restore`; the worktree
                         and branch are left for --clean. Without aoe the
                         tmux session is killed outright.

Session indicators (project picker, branch picker, session pickers, --list):
  ✖                      Agent hit an error
  ●                      Agent is waiting on you
  ◆                      Session is currently attached
  ◐                      Agent is working
  ◇                      Session exists but is idle or stopped
  (none)                 No active session

A project row shows the most urgent indicator among its own sessions and
those of its worktrees, so a branch waiting on input outranks an attached
session elsewhere in the project. ✖ ● ◐ need aoe: they come from the status
file its hooks write, so they appear whether or not aoe itself is running.

Labeled sessions are backed by a git worktree in WRK_WORKTREE_ROOT.
If a branch matching <label> exists locally or on origin, it is checked
out into the worktree. Otherwise a new branch is created from HEAD.

Each new worktree receives a unique WRK_PORT (written to its .env) and
inherits a copy of the parent project's .env at creation time. If mise
is installed, the worktree is automatically trusted so .env loads in
the shell. Without mise, WRK_PORT is set but won't auto-load.

--clean removes selected worktrees and for each one also deletes the
local git branch (if fully merged) and drops the session — killing the
tmux session, or purging every aoe session record rooted in the worktree.

Vaults (PKM workspaces — Obsidian vaults, OKF Knowledge Bundles) are
non-git directories. Flag one by creating a marker file (default
.wrk-vault) at its root, then point WRK_VAULT_ROOTS at the vault or at a
folder of vaults. Vaults appear in the picker tagged with 📓; selecting
one opens a plain session (no worktree, branch, or WRK_PORT).

If Agent of Empires (aoe) is installed it owns session lifecycle: wrk still
discovers projects, picks branches, and provisions worktrees, then hands the
path to `aoe add`. Worktree sessions launch claude; project and vault sessions
open a shell. Sessions are matched by path, so the naming below is unused in
this mode.

aoe only launches agents from its own allowlist, so shell sessions need a
custom agent declared in its config.toml. wrk also exports the SSH agent
symlink before handing off; forward it with a bare passthrough entry:

  environment = ["SSH_AUTH_SOCK"]

  [session]
  custom_agents = { shell = "zsh" }

Leave aoe's tmux.socket_name unset so both kinds of session share one server.
Without aoe, wrk creates and attaches tmux sessions itself.

Environment:
  WRK_PROJECT_ROOT   Root directory to scan for git repos (default: ~/git)
  WRK_WORKTREE_ROOT  Root directory for worktrees (default: ~/.wrk/worktrees)
  WRK_VAULT_ROOTS    Colon-separated vaults or folders of vaults (default: unset)
  WRK_VAULT_MARKER   Filename that flags a vault root (default: .wrk-vault)
EOF
}

# Sanitize a user-supplied label into a git-safe branch name (hyphens preserved).
branch_name() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '-'; }

# Sanitize a branch name into a tmux-safe session suffix (hyphens become underscores).
session_label() { local s="${1//[!a-zA-Z0-9]/_}"; printf '%s' "$s"; }

# --- Session backends ---
# wrk drives one of two backends, chosen once at startup rather than re-decided
# at each call site. `tmux` creates and attaches sessions itself; `aoe` hands
# lifecycle to Agent of Empires, keeping only the parts aoe has no notion of —
# org/repo discovery, vaults, WRK_PORT, the SSH agent symlink.
#
# Both implement the same seven functions — _prime, _rows, _project_key,
# _attach, _open, _kill, _purge_worktree — reached through the BACKEND
# indirection below, and both emit the same row format, so every picker,
# indicator and cleanup path is written once:
#
#   key ␟ pkey ␟ branch ␟ label ␟ glyph ␟ path ␟ isdef
#
#   key     opaque session handle — a tmux name or an aoe id. Only the backend
#           that produced it may interpret it.
#   pkey    project key, for grouping rows under the project they belong to.
#   branch  worktree branch, empty for a non-worktree session.
#   label   display name.
#   glyph   status indicator (see glyph_rank).
#   path    session directory, used for fzf previews.
#   isdef   1 for a project's unlabeled default session.
#
# jq is what reads `aoe list --json`; without it every lookup would come back
# empty and wrk would create a duplicate session instead of attaching, so a
# missing jq falls back to the tmux backend rather than a half-working aoe one.
has_aoe() { command -v aoe &>/dev/null && command -v jq &>/dev/null; }

# Rows are separated by US (0x1f), not tab. `read` treats tab as IFS whitespace
# and collapses runs of it, so a row with an empty field — every session that is
# not worktree-backed has an empty branch — would shift every later field left
# by one. US is not IFS whitespace, and cannot occur in a path or a title.
SEP=$'\x1f'

GLYPH_LEGEND='✖ error  ● waiting  ◆ attached  ◐ running  ◇ idle'

# Status glyph precedence, high to low. A project row shows the most urgent
# glyph among its sessions, so "something wants you" always outranks "something
# is attached".
#   ✖ error   ● waiting on you   ◆ attached   ◐ running   ◇ idle or stopped
#
# Answers through a global rather than stdout: the callers run per picker row,
# and a command substitution there would fork once per row.
GLYPH_RANK=0
glyph_rank() {
  case "$1" in
    '✖') GLYPH_RANK=5 ;;
    '●') GLYPH_RANK=4 ;;
    '◆') GLYPH_RANK=3 ;;
    '◐') GLYPH_RANK=2 ;;
    '◇') GLYPH_RANK=1 ;;
    *)   GLYPH_RANK=0 ;;
  esac
}

# Highest-ranked glyph among rows whose pkey matches, ' ' when none do. Answers
# in $IND rather than on stdout, and reads $_ROWS rather than calling
# backend_rows: the project picker runs this once per repo, and on a 65-repo
# machine each command substitution here is a fork the picker cannot afford.
IND=' '
rows_project_ind() {
  local pkey="$1" best=' ' best_rank=0 g p
  while IFS="$SEP" read -r _ p _ _ g _ _; do
    [ "$p" = "$pkey" ] || continue
    glyph_rank "$g"
    [ "$GLYPH_RANK" -gt "$best_rank" ] && { best="$g"; best_rank="$GLYPH_RANK"; }
  done <<< "$_ROWS"
  IND="$best"
}

# Glyph for one worktree of one project, given its <org>/<repo> and branch. The
# backends store the branch differently — aoe keeps it verbatim, tmux carries it
# through session_label — so both spellings are tried.
rows_worktree_ind() {
  local label="$2" pkey slabel best=' ' best_rank=0 g p b
  slabel="${label//[!a-zA-Z0-9]/_}"
  backend_project_key git "$PROJECT_ROOT/$1" "$1"; pkey="$PKEY"
  while IFS="$SEP" read -r _ p b _ g _ _; do
    [ "$p" = "$pkey" ] || continue
    [ "$b" = "$label" ] || [ "$b" = "$slabel" ] || continue
    glyph_rank "$g"
    [ "$GLYPH_RANK" -gt "$best_rank" ] && { best="$g"; best_rank="$GLYPH_RANK"; }
  done <<< "$_ROWS"
  printf '%s' "$best"
}

# --- tmux backend ---

# Project key for the tmux backend is the session base name. Vaults use a
# distinct namespace so they never collide with a git repo of the same basename.
# Inlines session_label and basename as parameter expansion rather than calling
# out: this runs once per picker row, where two forks per row is the whole
# startup budget.
tmux_project_key() {
  local n="${2##*/}"
  n="${n//[!a-zA-Z0-9]/_}"
  if [ "$1" = 'vault' ]; then PKEY="wrk-vault-$n"; else PKEY="wrk-$n"; fi
}

tmux_prime() { :; }

# Rows come from one `tmux list-sessions`. The base name up to `__` is the
# project key, so `wrk-webapp__fix_login` groups under `wrk-webapp`.
tmux_rows() {
  tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}'$'\t''#{session_path}' 2>/dev/null \
    | awk -F'\t' -v S="$SEP" '
        index($1, "wrk-") != 1 { next }
        {
          key = $1
          i = index(key, "__")
          pkey   = (i ? substr(key, 1, i - 1) : key)
          branch = (i ? substr(key, i + 2)    : "")
          glyph  = ($2 > 0 ? "◆" : "◇")
          isdef  = (i ? 0 : 1)
          printf "%s%s%s%s%s%s%s%s%s%s%s%s%s\n", key, S, pkey, S, branch, S, key, S, glyph, S, $3, S, isdef
        }' || true
}

# The tmux backend has no status channel of its own, so a row is only ever
# attached or not.
tmux_attach() {
  # `=` prefix forces exact-name targeting; without it tmux falls back to prefix
  # match and `wrk-foo` would resolve to an existing `wrk-foo__bar`.
  [ -L "$SSH_AUTH_SOCK_LINK" ] \
    && { tmux set-environment -t "=$1" SSH_AUTH_SOCK "$SSH_AUTH_SOCK_LINK" 2>/dev/null || true; }
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=$1"
  else
    exec tmux attach -d -t "=$1"
  fi
}

tmux_open() {
  local type="$1" path="$2" dir="$4" label="$5" branch="$6"
  local base session
  tmux_project_key "$type" "$path"; base="$PKEY"
  session="$base"
  [ -n "$branch" ] && session="${base}__$(session_label "$branch")"
  [ -z "$branch" ] && [ -n "$label" ] && session="${base}__$(session_label "$label")"

  if tmux has-session -t "=$session" 2>/dev/null; then
    tmux_attach "$session"
  fi
  # Always create detached, set the option, then attach. A bare `new-session`
  # attaches and blocks, so anything after it runs only once the session is
  # detached again — which is why allow-passthrough never reached a session
  # started from outside tmux.
  #
  # `-w` against `<session>:`, the same form aoe_tune uses: allow-passthrough is
  # a window option, so a bare session target fails with "no such window" and
  # the `|| true` reports success. It lands on the session's first window only;
  # a window opened later needs its own.
  [ -L "$SSH_AUTH_SOCK_LINK" ] && export SSH_AUTH_SOCK="$SSH_AUTH_SOCK_LINK"
  tmux new-session -ds "$session" -c "$dir"
  tmux set-option -w -t "=$session:" allow-passthrough on || true
  tmux_attach "$session"
}

# `=` prefix for the same exact-name reason as tmux_attach.
tmux_kill() { tmux kill-session -t "=$1" 2>/dev/null || true; }

tmux_purge_worktree() {
  local org_project="$2" label="$3"
  tmux kill-session \
    -t "=wrk-$(session_label "$(basename "$org_project")")__$(session_label "$label")" \
    2>/dev/null || true
}

# --- aoe backend ---

# `aoe list --json` publishes everything wrk needs to place a session: `tool`,
# and a `worktree` object carrying the branch and the repo it was cut from.
# Matching on `worktree.main_repo_path` is aoe's own record of which project a
# worktree belongs to — wrk used to re-derive that by string-prefixing paths
# against its own WORKTREE_ROOT layout, which only held while both tools agreed
# on the directory convention.
#
# `aoe list --json` prints a bare "No sessions found" line on an empty profile,
# so a jq parse failure is indistinguishable from — and treated as — no
# sessions. It also returns trashed records, which carry no `trashed_at` in the
# JSON, so the trashed ids are subtracted separately below; without that, wrk
# resurrects a session the user deliberately threw away.
_AOE_ROWS=''
_AOE_LOADED=false

aoe_prime() {
  local trashed
  # No --json on list-trash. Rows are two-space indented, the header is not, so
  # anchoring on the indent keeps the header from ever parsing as an id.
  #
  # Space-separated, not one id per line: the list is handed to the awk below
  # through -v, and BWK awk — the awk macOS ships — warns "newline in string" on
  # every embedded newline in a -v value. Ids are hex, so a space cannot occur
  # inside one, and splitting on a literal " " gets awk's whitespace handling,
  # which drops the trailing separator instead of yielding an empty field.
  trashed=$(aoe session list-trash 2>/dev/null | awk '/^  /{printf "%s ", $1}' || true)
  _AOE_ROWS=$(aoe list --json 2>/dev/null \
    | jq -r '.[] | [.id, .path, .title, .tool,
                    (.worktree.branch // ""), (.worktree.main_repo_path // "")]
             | join("\u001f")' 2>/dev/null \
    | awk -F"$SEP" -v trash="$trashed" '
        BEGIN { n = split(trash, t, " "); for (i = 1; i <= n; i++) skip[t[i]] = 1 }
        !($1 in skip)' || true)
  _AOE_LOADED=true
}

# Live agent status, written by the hooks aoe installs into the agent's own
# config. Because the agent writes it, it stays current with no aoe TUI, no
# serve daemon, and no aoe process running at all — which is the only channel
# that survives wrk's usual "attach and work" flow.
#
# Advisory only. aoe carries read_hook_status_age precisely because a missed
# idle hook leaves `running` standing; reconciling that is aoe's job, and a
# stale glyph here costs a glance.
#
# Answers in $STATUS, and reads through a redirect rather than a command
# substitution, so resolving a session's status costs one open and no fork.
#
# The 2>/dev/null precedes the input redirect deliberately: redirections are
# applied left to right, and a missing status file — the normal case for a
# shell session — reports its failure through whatever stderr is at that point.
_AOE_HOOK_BASE="/tmp/aoe-hooks-$(id -u)"
STATUS=''
aoe_status() {
  STATUS=''
  read -r STATUS 2>/dev/null < "$_AOE_HOOK_BASE/$1/status" || true
}

# Shell sessions have no agent hooks and so never have a status file; they fall
# through to the attached/exists pair correctly. Answers in $GLYPH.
GLYPH=' '
aoe_glyph() {
  aoe_status "$1"
  case "$STATUS" in
    error)   GLYPH='✖' ;;
    waiting) GLYPH='●' ;;
    running) [ "$2" -gt 0 ] && GLYPH='◆' || GLYPH='◐' ;;
    *)       [ "$2" -gt 0 ] && GLYPH='◆' || GLYPH='◇' ;;
  esac
}

aoe_rows() {
  $_AOE_LOADED || aoe_prime
  local id path title branch main pkey isdef
  while IFS="$SEP" read -r id path title _ branch main; do
    [ -z "$id" ] && continue
    pkey="${main:-$path}"
    # A project's default session is the one titled after the repo itself; a
    # worktree session is <repo>-<branch>, and a ctrl-t one <repo>-<label>.
    [ "$title" = "${pkey##*/}" ] && isdef=1 || isdef=0
    aoe_tmux_attached "$id"
    aoe_glyph "$id" "$ATTACHED"
    printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
      "$id" "$pkey" "$branch" "$title" "$GLYPH" "$path" "$isdef"
  done <<< "$_AOE_ROWS"
}

# aoe names its sessions aoe_<title>_<id8> and renames them freely, so the
# `_<id8>` tail is the only stable handle — the same one aoe matches on
# internally (agent_session_belongs_to). Resolved from a single tmux
# list-sessions cached for the process, since every row needs it.
_AOE_TMUX=''
_AOE_TMUX_LOADED=false
aoe_tmux_info() {
  if ! $_AOE_TMUX_LOADED; then
    _AOE_TMUX=$(tmux list-sessions \
      -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null \
      | grep '^aoe_' || true)
    _AOE_TMUX_LOADED=true
  fi
  printf '%s' "$_AOE_TMUX"
}

aoe_tmux_lookup() {
  aoe_tmux_info | awk -F'\t' -v t="_${1:0:8}" -v f="$2" \
    'substr($1, length($1) - length(t) + 1) == t {print $f; exit}'
}

# Answers in $ATTACHED, for the same no-fork reason as aoe_status.
ATTACHED=0
aoe_tmux_attached() { ATTACHED=$(aoe_tmux_lookup "$1" 2); ATTACHED="${ATTACHED:-0}"; }
aoe_tmux_name()     { aoe_tmux_lookup "$1" 1; }

# The tmux options aoe leaves to us, re-applied on every attach because aoe
# rebuilds the whole new-session chain each time it restarts a stopped session.
#
# allow-passthrough: aoe's default `tmux.clipboard = "auto"` skips it for anyone
# who has a tmux.conf, on the theory that they manage it themselves, and Claude
# Code needs it. Setting it here rather than relying on aoe's config keeps the
# behavior independent of a setting in another tool — and `"enabled"` would also
# turn on set-clipboard and live-send copy forwarding, which is more than wrk
# has any business asking for.
#
# remain-on-exit: aoe sets `on`, which tombstones a clean exit as readily as a
# crash. An agent wants `failed` — gone when you quit it, still there to read
# when it died. A shell wants `off`: bare `exit` returns the last command's
# status, so `failed` would tombstone at random. Keyed off the tool rather than
# the branch because the pickers reach this with no branch in scope.
aoe_tune() {
  local name tool
  name=$(aoe_tmux_name "$1")
  if [ -z "$name" ]; then
    # Only reachable if aoe stops naming its sessions aoe_<title>_<id8>. Silence
    # here would look exactly like the bugs these options fix.
    echo "wrk: no tmux session for aoe id '$1' — skipping option setup" >&2
    return 0
  fi
  tmux set-option -w -t "${name}:" allow-passthrough on 2>/dev/null || true
  $_AOE_LOADED || aoe_prime
  tool=$(printf '%s\n' "$_AOE_ROWS" | awk -F"$SEP" -v i="$1" '$1==i{print $4; exit}')
  if [ "$tool" = "$AOE_SHELL_TOOL" ]; then
    tmux set-option -p -t "${name}:" remain-on-exit off 2>/dev/null || true
  else
    tmux set-option -p -t "${name}:" remain-on-exit failed 2>/dev/null || true
  fi
  return 0
}

# `aoe session attach` refuses a session whose tmux process is stopped — the
# state every session is in after a reboot — so start it first. `aoe session
# start` is idempotent and will not spawn a second tmux session for one that is
# already running.
aoe_attach() {
  aoe session start "$1" &>/dev/null || true
  _AOE_TMUX_LOADED=false
  aoe_tune "$1"
  exec aoe session attach "$1"
}

# aoe matches on real paths, so the project key is just the project directory.
aoe_project_key() { PKEY="$2"; }

aoe_open() {
  local type="$1" path="$2" rel="$3" dir="$4" label="$5" branch="$6"
  local repo group title id
  repo="$(basename "$path")"
  if [ "$type" = 'vault' ]; then group='vaults'; else group="${rel%/*}"; fi
  title="$repo"
  [ -n "$branch" ] && title="$repo-$branch"
  [ -z "$branch" ] && [ -n "$label" ] && title="$repo-$(branch_name "$label")"

  # Export the agent symlink so aoe's `environment = ["SSH_AUTH_SOCK"]`
  # passthrough forwards it into the pane. Passing it by name rather than as a
  # literal path keeps aoe's config free of any machine-specific value.
  [ -L "$SSH_AUTH_SOCK_LINK" ] && export SSH_AUTH_SOCK="$SSH_AUTH_SOCK_LINK"

  id=$(aoe_find "$dir" "$title")
  if [ -z "$id" ]; then
    # No -l: create only, so wrk keeps control long enough to set the tmux
    # option aoe leaves alone. aoe_attach does the launching.
    if [ -n "$branch" ]; then
      # No -b: resolve_worktree already created the worktree, so aoe adopts it
      # as managed_by_aoe:false and will never relocate or delete it.
      aoe add "$path" -w "$branch" -t "$title" -g "$group" \
        --tool claude --trust-hooks >/dev/null
    else
      aoe add "$dir" -t "$title" -g "$group" --tool "$AOE_SHELL_TOOL" \
        --trust-hooks >/dev/null
    fi
    aoe_prime
    id=$(aoe_find "$dir" "$title")
    [ -z "$id" ] && { echo "wrk: aoe created no session for '$title'" >&2; exit 1; }
  fi
  aoe_attach "$id"
}

# Path alone is ambiguous whenever two sessions share a directory — a ctrl-t
# dev-server session next to the project's default one — so the title narrows it.
aoe_find() {
  printf '%s\n' "$_AOE_ROWS" | awk -F"$SEP" -v p="$1" -v t="$2" '$2==p && $3==t{print $1; exit}'
}

# The plain trash, not the --purge below: the worktree and branch outlive the
# session record here, so there is somewhere to restore it to. wrk's worktrees
# are managed_by_aoe:false, so no --delete-worktree either — a killed session
# leaves its worktree for --clean to deal with later.
aoe_kill() { aoe remove "$1" &>/dev/null || true; }

# Every session rooted in this worktree, not just the first: a ctrl-t session
# can sit alongside the branch session in the same directory, and the directory
# is about to go. --purge rather than the default trash: the worktree and branch
# are about to go, so there is nothing left to restore the record to. No
# --delete-worktree — wrk's worktrees are managed_by_aoe:false and the removal
# is wrk's to do.
aoe_purge_worktree() {
  local wt="$1" id
  $_AOE_LOADED || aoe_prime
  while IFS= read -r id; do
    [ -n "$id" ] && { aoe remove "$id" --purge &>/dev/null || true; }
  done < <(printf '%s\n' "$_AOE_ROWS" | awk -F"$SEP" -v p="$wt" '$2==p{print $1}')
}

# --- Backend selection ---
# The one place the choice is made. Everything below calls through BACKEND.
if command -v aoe &>/dev/null && ! command -v jq &>/dev/null; then
  echo 'wrk: aoe found but jq is missing — using plain tmux sessions' >&2
fi
BACKEND=tmux
has_aoe && BACKEND=aoe

backend_attach()  { "${BACKEND}_attach" "$@"; }
backend_open()    { "${BACKEND}_open" "$@"; }
backend_kill()    { "${BACKEND}_kill" "$@"; }
backend_purge_worktree() { "${BACKEND}_purge_worktree" "$@"; }

# Answers in $PKEY, not on stdout — see rows_project_ind.
PKEY=''
backend_project_key() { "${BACKEND}_project_key" "$@"; }

# Rows are fetched once, eagerly, in the caller's own shell. Every indicator and
# picker below runs inside a command substitution, so a lazily-filled cache
# would be populated in a subshell and thrown away — leaving each of ~65 project
# rows to re-run the backend query. That is the regression 1.5.3 fixed, and the
# reason priming is a separate step rather than a side effect of the first read.
_ROWS=''
backend_prime() {
  "${BACKEND}_prime"
  _ROWS=$("${BACKEND}_rows")
}
backend_rows() { printf '%s' "$_ROWS"; }

# Terminate a session from a picker: confirm, kill, re-prime so the caller's next
# read of backend_rows no longer sees it. Non-zero on a declined confirmation, so
# a caller can tell "nothing happened" from "the list changed".
kill_session() {
  local key="$1" label="$2" reply
  printf "Terminate '%s'? [y/N] " "$label" >&2
  read -r reply
  case "$reply" in
    y|Y) ;;
    *) return 1 ;;
  esac
  backend_kill "$key"
  backend_prime
}

# Point a stable symlink at the current shell's SSH agent socket. Sessions are
# given SSH_AUTH_SOCK_LINK (not the raw socket path) as their SSH_AUTH_SOCK, so
# reattaching from a different SSH connection — which has its own forwarded
# socket path — keeps working: resolution happens through the symlink at
# connect-time, not at shell-start time.
sync_ssh_agent() {
  [ -S "${SSH_AUTH_SOCK:-}" ] || return 0
  mkdir -p "$(dirname "$SSH_AUTH_SOCK_LINK")"
  ln -sf "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK_LINK"
}

setup_worktree_env() {
  local project_path="$1" worktree_path="$2"

  # Copy .env from parent, stripping any existing WRK_PORT so we always assign a fresh one
  if [ ! -f "$worktree_path/.env" ] && [ -f "$project_path/.env" ]; then
    grep -v '^WRK_PORT=' "$project_path/.env" > "$worktree_path/.env"
  fi

  # Assign a unique WRK_PORT (skip if already set)
  if ! grep -q '^WRK_PORT=' "$worktree_path/.env" 2>/dev/null; then
    local used_ports=()
    while IFS= read -r p; do
      used_ports+=("$p")
    done < <(grep -h '^WRK_PORT=' "$WORKTREE_ROOT"/*/*/*/.env 2>/dev/null \
      | cut -d= -f2 || true)

    local port
    while true; do
      port=$(( RANDOM % 6001 + 3000 ))
      local taken=false
      for p in "${used_ports[@]+"${used_ports[@]}"}"; do
        [ "$p" = "$port" ] && taken=true && break
      done
      $taken && continue
      lsof -iTCP:"$port" -sTCP:LISTEN -t &>/dev/null && continue
      break
    done

    printf 'WRK_PORT=%s\n' "$port" >> "$worktree_path/.env"
  fi

  if command -v mise &>/dev/null; then
    mise trust "$worktree_path" &>/dev/null
  else
    echo "wrk: mise not found — WRK_PORT set in .env but won't auto-load" >&2
  fi
}

resolve_worktree() {
  local project_path="$1" project_rel="$2" branch="$3"
  local wt="$WORKTREE_ROOT/$project_rel/$branch"
  mkdir -p "$(dirname "$wt")"

  if [ ! -d "$wt" ]; then
    if git -C "$project_path" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$project_path" worktree add "$wt" "$branch" >&2
    else
      git -C "$project_path" fetch --quiet origin 2>/dev/null || true
      if git -C "$project_path" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$project_path" worktree add --track -b "$branch" "$wt" "origin/$branch" >&2
      else
        git -C "$project_path" worktree add -b "$branch" "$wt" >&2
      fi
    fi
  fi

  setup_worktree_env "$project_path" "$wt"
  printf '%s' "$wt"
}

pick_branch() {
  local project_path="$1" project_rel="$2" pkey="$3"

  git -C "$project_path" fetch --quiet --prune origin 2>/dev/null || true

  backend_prime

  local branches
  branches=$(
    {
      printf '[new]\n'
      git -C "$project_path" branch --format='%(refname:short)' 2>/dev/null
      git -C "$project_path" branch -r --format='%(refname:short)' 2>/dev/null \
        | sed 's|^origin/||' | grep -v '^HEAD'
    } | sort -u | grep -v '^$'
  )

  # A branch's glyph comes from the row whose project and branch both match.
  # Matching the branch as well as the project is what keeps a ctrl-t session
  # sharing the worktree directory from shadowing the branch's own indicator.
  local rows ind
  rows=$(backend_rows)

  local lines=()
  while IFS= read -r b; do
    if [ "$b" = '[new]' ]; then
      lines+=("$b"$'\t'"  $b")
      continue
    fi
    ind=$(printf '%s\n' "$rows" | awk -F"$SEP" \
      -v p="$pkey" -v b1="$(branch_name "$b")" -v b2="$(session_label "$b")" \
      '$2==p && ($3==b1 || $3==b2) {print $5; exit}')
    lines+=("$b"$'\t'"${ind:- } $b")
  done <<< "$branches"

  local branch
  branch=$(printf '%s\n' "${lines[@]}" \
    | fzf --delimiter=$'\t' --with-nth=2 \
          --preview '' --prompt='Branch: ' \
          --header="[new] for new branch  $GLYPH_LEGEND") || return 1

  branch=$(printf '%s' "$branch" | cut -f1)
  if [ "$branch" = '[new]' ]; then
    printf 'Branch name: ' >&2
    read -r branch
  fi
  printf '%s' "$branch"
}

cmd_list() {
  local found=false
  backend_prime
  printf '%-42s %-30s %-8s %s\n' 'WORKTREE' 'BRANCH' 'PORT' 'STATUS'
  for wt in "$WORKTREE_ROOT"/*/*/*; do
    [ -e "$wt/.git" ] || continue
    found=true
    local rel="${wt#"$WORKTREE_ROOT"/}"
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || branch='(detached)'
    local port
    port=$(grep '^WRK_PORT=' "$wt/.env" 2>/dev/null | cut -d= -f2 || echo '—')
    printf '%-42s %-30s %-8s %s\n' "$rel" "$branch" "$port" \
      "$(rows_worktree_ind "${rel%/*}" "${rel##*/}")"
  done
  $found || echo 'No worktrees found.'
  $found && printf '\n%s\n' "$GLYPH_LEGEND"
  return 0
}

cmd_clean() {
  # Prune stale worktree metadata from all source repos that have a worktrees dir
  for wt_dir in "$WORKTREE_ROOT"/*/*; do
    [ -d "$wt_dir" ] || continue
    local rel="${wt_dir#"$WORKTREE_ROOT"/}"
    local source="$PROJECT_ROOT/$rel"
    [ -d "$source/.git" ] && git -C "$source" worktree prune 2>/dev/null || true
  done

  local merged=() unmerged=()

  for wt in "$WORKTREE_ROOT"/*/*/*; do
    [ -e "$wt/.git" ] || continue
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || continue
    [ -z "$branch" ] && continue

    local rel="${wt#"$WORKTREE_ROOT"/}"
    local org_project="${rel%/*}"
    local source="$PROJECT_ROOT/$org_project"
    [ -d "$source/.git" ] || continue

    local base
    base=$(git -C "$source" symbolic-ref --short HEAD 2>/dev/null) || base='main'
    git -C "$source" fetch --quiet origin "$base" 2>/dev/null || true

    # --format drops the two-column marker prefix. Plain `git branch` marks a
    # branch checked out in another worktree with `+`, which every wrk worktree
    # branch is by definition, so a whitespace-only prefix never matched and
    # nothing was ever classified as merged.
    if git -C "$source" branch --merged "origin/$base" --format='%(refname:short)' 2>/dev/null \
        | grep -qFx "$branch"; then
      merged+=("$rel")
    else
      unmerged+=("$rel")
    fi
  done

  if [ "${#merged[@]}" -eq 0 ] && [ "${#unmerged[@]}" -eq 0 ]; then
    echo 'No worktrees found.'
    return
  fi

  local to_remove=()
  backend_prime

  _clean_lines() {
    local rel
    for rel in "$@"; do
      printf '%s\t%s %s\n' "$rel" "$(rows_worktree_ind "${rel%/*}" "${rel##*/}")" "$rel"
    done
  }

  if [ "${#merged[@]}" -gt 0 ]; then
    local selected
    selected=$(_clean_lines "${merged[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 \
            --preview "tree -C -L 1 $WORKTREE_ROOT/{1}" \
            --multi --bind 'load:select-all' \
            --prompt='Remove merged worktrees? ' \
            --header="TAB to deselect, ENTER to confirm  $GLYPH_LEGEND" || true)
    while IFS= read -r line; do
      [ -n "$line" ] && to_remove+=("$(printf '%s' "$line" | cut -f1)")
    done <<< "$selected"
  fi

  if [ "${#unmerged[@]}" -gt 0 ]; then
    local extra
    extra=$(_clean_lines "${unmerged[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 \
            --preview "tree -C -L 1 $WORKTREE_ROOT/{1}" \
            --multi \
            --prompt='Also remove unmerged worktrees? ' \
            --header="TAB to select, ENTER to skip  $GLYPH_LEGEND" || true)
    while IFS= read -r line; do
      [ -n "$line" ] && to_remove+=("$(printf '%s' "$line" | cut -f1)")
    done <<< "$extra"
  fi

  for rel in "${to_remove[@]+"${to_remove[@]}"}"; do
    local wt="$WORKTREE_ROOT/$rel"
    local org_project="${rel%/*}"
    local label="${rel##*/}"
    local source="$PROJECT_ROOT/$org_project"
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || branch=''

    # Drop the session first, so that under aoe its on_destroy hooks still see a
    # live worktree.
    backend_purge_worktree "$wt" "$org_project" "$label"

    git -C "$source" worktree remove "$wt" 2>/dev/null \
      || git -C "$source" worktree remove --force "$wt"

    if [ -n "$branch" ]; then
      git -C "$source" branch -d "$branch" 2>/dev/null \
        || echo "Note: branch '$branch' not deleted (may have unmerged commits)"
    fi

    echo "Removed: $rel"
  done
}

# Handle subcommands before project discovery
case "${1:-}" in
  --help)    show_help; exit 0 ;;
  --version) echo "wrk $VERSION"; exit 0 ;;
  --list)    cmd_list;  exit 0 ;;
  --clean)   cmd_clean; exit 0 ;;
esac

sync_ssh_agent

# --- Project discovery ---

PROJECTS=()
for gitdir in "$PROJECT_ROOT"/*/*/.git; do
  [ -d "$gitdir" ] || continue
  PROJECTS+=( "${gitdir%/.git}" )
done

# Vault discovery (opt-in). Each WRK_VAULT_ROOTS entry is either a vault itself
# (contains the marker) or a folder scanned one level deep for vaults.
VAULTS=()
if [ -n "${WRK_VAULT_ROOTS:-}" ]; then
  IFS=':' read -r -a _roots <<< "$WRK_VAULT_ROOTS"
  for _root in "${_roots[@]}"; do
    [ -d "$_root" ] || continue
    if [ -e "$_root/$VAULT_MARKER" ]; then
      VAULTS+=( "${_root%/}" )
    else
      for _d in "$_root"/*/; do
        [ -e "${_d%/}/$VAULT_MARKER" ] && VAULTS+=( "${_d%/}" )
      done
    fi
  done
fi

[ "${#PROJECTS[@]}" -eq 0 ] && [ "${#VAULTS[@]}" -eq 0 ] && exit 0

backend_prime

# Picker rows carry: type \t abspath \t rel \t "<glyph> display"
# (rel is empty for vaults; the display field is the only one shown.)
# No command substitution in either loop: both helpers answer through globals so
# a 65-repo picker costs zero forks here.
_project_lines=()
for _p in "${PROJECTS[@]+"${PROJECTS[@]}"}"; do
  _rel="${_p#"$PROJECT_ROOT"/}"
  backend_project_key git "$_p" "$_rel"
  rows_project_ind "$PKEY"
  _project_lines+=("git"$'\t'"$_p"$'\t'"$_rel"$'\t'"$IND $_rel")
done
for _v in "${VAULTS[@]+"${VAULTS[@]}"}"; do
  backend_project_key vault "$_v" ''
  rows_project_ind "$PKEY"
  _project_lines+=("vault"$'\t'"$_v"$'\t'$'\t'"$IND 📓 ${_v##*/}")
done

_fzf_result=$(printf '%s\n' "${_project_lines[@]}" \
  | fzf --delimiter=$'\t' --with-nth=4 \
        --preview 'tree -C -L 1 {2}' \
        --prompt='What do you want to work on? ' --query "${1:-}" \
        --expect=ctrl-o,ctrl-t,ctrl-x \
        --header="<C-o>: + worktree  <C-t>: + session  <C-x>: filter active  📓 vault
$GLYPH_LEGEND")

[ -z "$_fzf_result" ] && exit 0

_fzf_key=$(printf '%s' "$_fzf_result" | head -1)
_fzf_line=$(printf '%s' "$_fzf_result" | tail -1)

# Every session the backend knows about, not just this project's. Under aoe that
# deliberately includes sessions aoe created outside wrk — the one place wrk is
# aoe-native rather than wrk-scoped.
#
# Looped so a terminate re-enters the picker against freshly primed rows rather
# than dropping back to the project picker: ending sessions comes in batches.
if [ "$_fzf_key" = 'ctrl-x' ]; then
  while true; do
    _rows=$(backend_rows)
    if [ -z "$_rows" ]; then
      tmux display-message "No active sessions"
      exec "$0" "$@"
    fi
    _sess=$(printf '%s\n' "$_rows" \
      | awk -F"$SEP" 'NF{printf "%s\t%s %s\t%s\n", $1, $5, $4, $6}' \
      | fzf --delimiter=$'\t' --with-nth=2 \
            --preview 'tree -C -L 1 {3}' \
            --prompt='Session: ' \
            --expect=ctrl-d \
            --header="enter: attach  <C-d>: terminate  $GLYPH_LEGEND") || true
    [ -z "$_sess" ] && exit 0
    _sess_key=$(printf '%s' "$_sess" | head -1)
    _sess_line=$(printf '%s' "$_sess" | tail -1)
    if [ "$_sess_key" = 'ctrl-d' ]; then
      kill_session "$(printf '%s' "$_sess_line" | cut -f1)" \
                   "$(printf '%s' "$_sess_line" | cut -f2)" || true
      continue
    fi
    backend_attach "$(printf '%s' "$_sess_line" | cut -f1)"
  done
fi

TYPE=$(printf '%s' "$_fzf_line" | cut -f1)
PROJECT_PATH=$(printf '%s' "$_fzf_line" | cut -f2)
PROJECT_REL=$(printf '%s' "$_fzf_line" | cut -f3)

[ -z "$PROJECT_PATH" ] && exit 0

backend_project_key "$TYPE" "$PROJECT_PATH" "$PROJECT_REL"

# What to open, in backend-neutral terms: the directory, an optional free-form
# label, and a branch that is set only for worktree-backed sessions. The backend
# turns these into a tmux name or an aoe title.
SESSION_DIR="$PROJECT_PATH"
LABEL=''
BRANCH=''

if [ -n "${2:-}" ] && [ "$TYPE" = 'vault' ]; then
  LABEL="$2"
elif [ -n "${2:-}" ]; then
  BRANCH="$(branch_name "$2")"
  SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
elif [ "$_fzf_key" = 'ctrl-o' ] && [ "$TYPE" != 'vault' ]; then
  raw_label=$(pick_branch "$PROJECT_PATH" "$PROJECT_REL" "$PKEY") || exit 0
  [ -z "$raw_label" ] && exit 0
  BRANCH="$(branch_name "$raw_label")"
  SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
elif [ "$_fzf_key" = 'ctrl-t' ]; then
  printf 'Session name: ' >&2
  read -r LABEL
  [ -z "$LABEL" ] && exit 0
else
  # Sub-picker over this project's existing sessions. Picking one attaches and
  # exits; the sentinels fall through to creation below. A lone default session
  # opens straight through rather than through a one-item picker.
  #
  # Looped for the same reason as the ctrl-x picker. Terminating down to nothing
  # but the default session stops the condition below from holding, and the loop
  # falls out to creation rather than re-entering a picker that no longer earns
  # its place.
  while true; do
    _lines=() _only_default=true
    while IFS="$SEP" read -r _key _pkey _ _label _glyph _ _isdef; do
      [ "$_pkey" = "$PKEY" ] || continue
      [ "$_isdef" = '1' ] || _only_default=false
      [ "$_isdef" = '1' ] && _label='[default]'
      _lines+=("$_key"$'\t'"$_glyph $_label")
    done <<< "$(backend_rows)"

    [ "${#_lines[@]}" -gt 1 ] || \
      { [ "${#_lines[@]}" -eq 1 ] && ! $_only_default; } || break

    _lines+=('[new session]'$'\t''  [new session]')
    [ "$TYPE" != 'vault' ] && _lines+=('[new worktree]'$'\t''  [new worktree]')

    _pick=$(printf '%s\n' "${_lines[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 --preview '' \
            --prompt='Session? ' --expect=ctrl-d \
            --header="<C-d>: terminate  $GLYPH_LEGEND") || true
    [ -z "$_pick" ] && exit 0
    _pick_key=$(printf '%s' "$_pick" | head -1)
    _pick_line=$(printf '%s' "$_pick" | tail -1)
    _pick=$(printf '%s' "$_pick_line" | cut -f1)

    # The sentinels are creation entry points, not sessions — nothing to kill.
    if [ "$_pick_key" = 'ctrl-d' ]; then
      case "$_pick" in
        '[new session]'|'[new worktree]') ;;
        *) kill_session "$_pick" "$(printf '%s' "$_pick_line" | cut -f2)" || true ;;
      esac
      continue
    fi

    case "$_pick" in
      '[new session]')
        printf 'Session name: '
        read -r LABEL
        [ -z "$LABEL" ] && exit 0
        ;;
      '[new worktree]')
        printf 'Session name: '
        read -r raw_label
        [ -z "$raw_label" ] && exit 0
        BRANCH="$(branch_name "$raw_label")"
        SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
        ;;
      *) backend_attach "$_pick" ;;
    esac
    break
  done
fi

if [ "$TYPE" != 'vault' ] && command -v mise &>/dev/null \
   && [ "$SESSION_DIR" = "$PROJECT_PATH" ]; then
  mise trust "$SESSION_DIR" &>/dev/null
fi

backend_open "$TYPE" "$PROJECT_PATH" "$PROJECT_REL" "$SESSION_DIR" "$LABEL" "$BRANCH"
