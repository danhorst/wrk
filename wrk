#!/usr/bin/env bash
set -euo pipefail

VERSION="1.7.1"

PROJECT_ROOT="${WRK_PROJECT_ROOT:-$HOME/git}"
WORKTREE_ROOT="${WRK_WORKTREE_ROOT:-$HOME/.wrk/worktrees}"
VAULT_MARKER="${WRK_VAULT_MARKER:-.wrk-vault}"
# aoe validates --cmd against its agent allowlist, so a plain shell has to be
# reached through a custom agent the user declares in aoe's config.toml.
AOE_SHELL_TOOL="${WRK_AOE_SHELL_TOOL:-shell}"
SSH_AUTH_SOCK_LINK="$(dirname "$WORKTREE_ROOT")/ssh-auth-sock"

show_help() {
  cat <<'EOF'
wrk — tmux session manager for git projects

Usage:
  wrk [query]            Fuzzy-select a project (query pre-fills the search)
  wrk <project> <label>  Open or create a labeled sub-project session
  wrk --list             List all worktrees and their status
  wrk --clean            Review and remove worktrees for merged branches
  wrk --version          Show version
  wrk --help             Show this help

Hotkeys (in the project picker):
  ctrl-o                 Open a branch picker for the highlighted project;
                         creates a worktree-backed session for the chosen branch
  ctrl-t                 Open a named session for the highlighted project
                         in the same directory (no worktree)
  ctrl-x                 Switch to a picker of all live wrk sessions,
                         showing ◆ attached and ◇ detached

Session indicators (project picker, branch picker, session pickers, --list):
  ◆                      Session is currently attached
  ◇                      Session exists but is detached
  (none)                 No active session

Labeled sessions are backed by a git worktree in WRK_WORKTREE_ROOT.
If a branch matching <label> exists locally or on origin, it is checked
out into the worktree. Otherwise a new branch is created from HEAD.

Each new worktree receives a unique WRK_PORT (written to its .env) and
inherits a copy of the parent project's .env at creation time. If mise
is installed, the worktree is automatically trusted so .env loads in
the shell. Without mise, WRK_PORT is set but won't auto-load.

--clean removes selected worktrees and for each one also deletes the
local git branch (if fully merged) and kills the tmux session, or purges
the aoe session record when running under aoe.

Vaults (PKM workspaces — Obsidian vaults, OKF Knowledge Bundles) are
non-git directories. Flag one by creating a marker file (default
.wrk-vault) at its root, then point WRK_VAULT_ROOTS at the vault or at a
folder of vaults. Vaults appear in the picker tagged with 📓; selecting
one opens a plain session (no worktree, branch, or WRK_PORT).

If Agent of Empires (aoe) is installed it owns session lifecycle: wrk still
discovers projects, picks branches, and provisions worktrees, then hands the
path to `aoe add`. Worktree sessions launch claude; project and vault sessions
open a shell. Sessions are matched by path, so the naming below is unused in
this mode.

aoe only launches agents from its own allowlist, so shell sessions need a
custom agent declared in its config.toml. wrk also exports the SSH agent
symlink before handing off; forward it with a bare passthrough entry:

  environment = ["SSH_AUTH_SOCK"]

  [session]
  custom_agents = { shell = "zsh" }

Leave aoe's tmux.socket_name unset so both kinds of session share one server.
Without aoe, wrk creates and attaches tmux sessions itself.

Environment:
  WRK_PROJECT_ROOT   Root directory to scan for git repos (default: ~/git)
  WRK_WORKTREE_ROOT  Root directory for worktrees (default: ~/.wrk/worktrees)
  WRK_VAULT_ROOTS    Colon-separated vaults or folders of vaults (default: unset)
  WRK_VAULT_MARKER   Filename that flags a vault root (default: .wrk-vault)
EOF
}

# Sanitize a user-supplied label into a git-safe branch name (hyphens preserved).
branch_name() { printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '-'; }

# Sanitize a branch name into a tmux-safe session suffix (hyphens become underscores).
session_label() { local s="${1//[!a-zA-Z0-9]/_}"; printf '%s' "$s"; }

# --- Agent of Empires (aoe) integration ---
# When aoe is installed it owns session lifecycle. wrk still discovers projects,
# picks branches, and provisions worktrees, then hands the path to `aoe add`.
# Sessions are matched by path, never by name: aoe derives its tmux names as
# aoe_<title>_<id8> from a UUID that does not exist until the session record
# does, so there is no name wrk could construct in advance.
# jq is what reads `aoe list --json`; without it every lookup would come back
# empty and wrk would create a duplicate session instead of attaching.
has_aoe() { command -v aoe &>/dev/null && command -v jq &>/dev/null; }

# `path<TAB>id<TAB>title` for every aoe session, fetched once per run.
# `aoe list --json` prints a bare "No sessions found" line on an empty profile,
# so a jq parse failure is indistinguishable from — and treated as — no
# sessions.
_AOE_SESSIONS=''
_AOE_LOADED=false
aoe_sessions() {
  if ! $_AOE_LOADED; then
    _AOE_SESSIONS=$(aoe list --json 2>/dev/null \
      | jq -r '.[] | "\(.path)\t\(.id)\t\(.title)"' 2>/dev/null || true)
    _AOE_LOADED=true
  fi
  printf '%s' "$_AOE_SESSIONS"
}

# Resolve a session id by path, optionally narrowed to one title. Path alone is
# ambiguous whenever two sessions share a directory — a ctrl-t dev-server
# session next to the project's default one — so callers that know which
# session they mean must pass the title too.
aoe_session_id() {
  aoe_sessions | awk -F'\t' -v p="$1" -v t="${2:-}" \
    '$1==p && (t=="" || $3==t) {print $2; exit}'
}

# Fill the cache in the caller's shell. The indicator helpers below run inside
# command substitutions, so without this every picker row would pay for its own
# `aoe list` in a subshell that then throws the result away. Called once per
# entry point, which also makes it the place to warn about a missing jq.
aoe_prime() {
  if command -v aoe &>/dev/null && ! command -v jq &>/dev/null; then
    echo 'wrk: aoe found but jq is missing — using plain tmux sessions' >&2
  fi
  if has_aoe; then aoe_sessions >/dev/null; fi
}

# Attach to an aoe session, replacing this process. `aoe session attach` refuses
# a session whose tmux process is stopped — the state every session is in after
# a reboot — so start it first. `aoe session start` is idempotent and will not
# spawn a second tmux session for one that is already running.
aoe_attach() {
  aoe session start "$1" &>/dev/null || true
  exec aoe session attach "$1"
}

# ◆/◇/' ' for an aoe session id, given a tmux `name<TAB>attached` blob. The
# `_<id8>` tail is aoe's durable handle from a session record to its panes,
# immutable across renames. A record whose tmux session is stopped is present,
# not absent, so it still rates ◇.
aoe_ind() {
  local id="$1" info="$2"
  [ -z "$id" ] && { printf ' '; return; }
  local att
  att=$(printf '%s\n' "$info" | awk -F'\t' -v t="_${id:0:8}" \
    'index($1,"aoe_")==1 && substr($1,length($1)-length(t)+1)==t {print $2; exit}')
  [ "${att:-0}" -gt 0 ] && printf '◆' || printf '◇'
}

# ◆/◇/' ' for a project: any aoe session at the project itself or in one of its
# worktrees counts, attached winning over merely present.
aoe_project_ind() {
  local ppath="$1" rel="$2" info="$3" best=' ' p id ind
  # Third field is read into `_` so `id` does not absorb the title.
  while IFS=$'\t' read -r p id _; do
    [ -z "$p" ] && continue
    [ "$p" = "$ppath" ] \
      || { [ -n "$rel" ] && [[ "$p" == "$WORKTREE_ROOT/$rel/"* ]]; } \
      || continue
    ind=$(aoe_ind "$id" "$info")
    [ "$ind" = '◆' ] && { printf '◆'; return; }
    best="$ind"
  done <<< "$(aoe_sessions)"
  printf '%s' "$best"
}

# Point a stable symlink at the current shell's SSH agent socket. Sessions are
# given SSH_AUTH_SOCK_LINK (not the raw socket path) as their SSH_AUTH_SOCK, so
# reattaching from a different SSH connection — which has its own forwarded
# socket path — keeps working: resolution happens through the symlink at
# connect-time, not at shell-start time.
sync_ssh_agent() {
  [ -S "${SSH_AUTH_SOCK:-}" ] || return 0
  mkdir -p "$(dirname "$SSH_AUTH_SOCK_LINK")"
  ln -sf "$SSH_AUTH_SOCK" "$SSH_AUTH_SOCK_LINK"
}

setup_worktree_env() {
  local project_path="$1" worktree_path="$2"

  # Copy .env from parent, stripping any existing WRK_PORT so we always assign a fresh one
  if [ ! -f "$worktree_path/.env" ] && [ -f "$project_path/.env" ]; then
    grep -v '^WRK_PORT=' "$project_path/.env" > "$worktree_path/.env"
  fi

  # Assign a unique WRK_PORT (skip if already set)
  if ! grep -q '^WRK_PORT=' "$worktree_path/.env" 2>/dev/null; then
    local used_ports=()
    while IFS= read -r p; do
      used_ports+=("$p")
    done < <(grep -h '^WRK_PORT=' "$WORKTREE_ROOT"/*/*/*/.env 2>/dev/null \
      | cut -d= -f2 || true)

    local port
    while true; do
      port=$(( RANDOM % 6001 + 3000 ))
      local taken=false
      for p in "${used_ports[@]+"${used_ports[@]}"}"; do
        [ "$p" = "$port" ] && taken=true && break
      done
      $taken && continue
      lsof -iTCP:"$port" -sTCP:LISTEN -t &>/dev/null && continue
      break
    done

    printf 'WRK_PORT=%s\n' "$port" >> "$worktree_path/.env"
  fi

  if command -v mise &>/dev/null; then
    mise trust "$worktree_path" &>/dev/null
  else
    echo "wrk: mise not found — WRK_PORT set in .env but won't auto-load" >&2
  fi
}

resolve_worktree() {
  local project_path="$1" project_rel="$2" branch="$3"
  local wt="$WORKTREE_ROOT/$project_rel/$branch"
  mkdir -p "$(dirname "$wt")"

  if [ ! -d "$wt" ]; then
    if git -C "$project_path" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$project_path" worktree add "$wt" "$branch" >&2
    else
      git -C "$project_path" fetch --quiet origin 2>/dev/null || true
      if git -C "$project_path" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        git -C "$project_path" worktree add --track -b "$branch" "$wt" "origin/$branch" >&2
      else
        git -C "$project_path" worktree add -b "$branch" "$wt" >&2
      fi
    fi
  fi

  setup_worktree_env "$project_path" "$wt"
  printf '%s' "$wt"
}

pick_branch() {
  local project_path="$1" project_rel="$2"
  local base="wrk-$(session_label "$(basename "$project_path")")"

  git -C "$project_path" fetch --quiet --prune origin 2>/dev/null || true

  local full_info sess_info attached_sess all_sess
  aoe_prime
  full_info=$(tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null || true)
  sess_info=$(printf '%s\n' "$full_info" | grep -E "^${base}__" || true)
  attached_sess=$(printf '%s\n' "$sess_info" | awk -F'\t' '$2>0{print $1}')
  all_sess=$(printf '%s\n' "$sess_info" | cut -f1)

  local branches
  branches=$(
    {
      printf '[new]\n'
      git -C "$project_path" branch --format='%(refname:short)' 2>/dev/null
      git -C "$project_path" branch -r --format='%(refname:short)' 2>/dev/null \
        | sed 's|^origin/||' | grep -v '^HEAD'
    } | sort -u | grep -v '^$'
  )

  local lines=() ind sname
  while IFS= read -r b; do
    if [ "$b" = '[new]' ]; then
      lines+=("$b"$'\t'"  $b")
    elif has_aoe; then
      ind=$(aoe_ind \
        "$(aoe_session_id "$WORKTREE_ROOT/$project_rel/$(branch_name "$b")")" \
        "$full_info")
      lines+=("$b"$'\t'"$ind $b")
    else
      sname="${base}__$(session_label "$b")"
      if printf '%s\n' "$attached_sess" | grep -qFx "$sname"; then
        ind='◆'
      elif printf '%s\n' "$all_sess" | grep -qFx "$sname"; then
        ind='◇'
      else
        ind=' '
      fi
      lines+=("$b"$'\t'"$ind $b")
    fi
  done <<< "$branches"

  local branch
  branch=$(printf '%s\n' "${lines[@]}" \
    | fzf --delimiter=$'\t' --with-nth=2 \
          --preview '' --prompt='Branch: ' \
          --header='[new] for new branch  ◆ attached  ◇ detached') || return 1

  branch=$(printf '%s' "$branch" | cut -f1)
  if [ "$branch" = '[new]' ]; then
    printf 'Branch name: ' >&2
    read -r branch
  fi
  printf '%s' "$branch"
}

cmd_list() {
  local found=false sess_info attached ind
  aoe_prime
  sess_info=$(tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null || true)
  printf '%-42s %-30s %-8s %s\n' 'WORKTREE' 'BRANCH' 'PORT' 'STATUS'
  for wt in "$WORKTREE_ROOT"/*/*/*; do
    [ -e "$wt/.git" ] || continue
    found=true
    local rel="${wt#"$WORKTREE_ROOT"/}"
    local org_project="${rel%/*}"
    local label="${rel##*/}"
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || branch='(detached)'
    local port
    port=$(grep '^WRK_PORT=' "$wt/.env" 2>/dev/null | cut -d= -f2 || echo '—')
    if has_aoe; then
      ind=$(aoe_ind "$(aoe_session_id "$wt")" "$sess_info")
    else
      local sname="wrk-$(session_label "$(basename "$org_project")")__$(session_label "$label")"
      attached=$(printf '%s\n' "$sess_info" | awk -F'\t' -v s="$sname" '$1==s{print $2; exit}')
      if [ -z "$attached" ]; then ind=' '
      elif [ "$attached" -gt 0 ]; then ind='◆'
      else ind='◇'
      fi
    fi
    printf '%-42s %-30s %-8s %s\n' "$rel" "$branch" "$port" "$ind"
  done
  $found || echo 'No worktrees found.'
}

cmd_clean() {
  # Prune stale worktree metadata from all source repos that have a worktrees dir
  for wt_dir in "$WORKTREE_ROOT"/*/*; do
    [ -d "$wt_dir" ] || continue
    local rel="${wt_dir#"$WORKTREE_ROOT"/}"
    local source="$PROJECT_ROOT/$rel"
    [ -d "$source/.git" ] && git -C "$source" worktree prune 2>/dev/null || true
  done

  local merged=() unmerged=()

  for wt in "$WORKTREE_ROOT"/*/*/*; do
    [ -e "$wt/.git" ] || continue
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || continue
    [ -z "$branch" ] && continue

    local rel="${wt#"$WORKTREE_ROOT"/}"
    local org_project="${rel%/*}"
    local source="$PROJECT_ROOT/$org_project"
    [ -d "$source/.git" ] || continue

    local base
    base=$(git -C "$source" symbolic-ref --short HEAD 2>/dev/null) || base='main'
    git -C "$source" fetch --quiet origin "$base" 2>/dev/null || true

    # --format drops the two-column marker prefix. Plain `git branch` marks a
    # branch checked out in another worktree with `+`, which every wrk worktree
    # branch is by definition, so a whitespace-only prefix never matched and
    # nothing was ever classified as merged.
    if git -C "$source" branch --merged "origin/$base" --format='%(refname:short)' 2>/dev/null \
        | grep -qFx "$branch"; then
      merged+=("$rel")
    else
      unmerged+=("$rel")
    fi
  done

  if [ "${#merged[@]}" -eq 0 ] && [ "${#unmerged[@]}" -eq 0 ]; then
    echo 'No worktrees found.'
    return
  fi

  local to_remove=()
  local clean_sess_info
  aoe_prime
  clean_sess_info=$(tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null || true)

  _clean_lines() {
    local rel org_project label sname att ind
    for rel in "$@"; do
      if has_aoe; then
        ind=$(aoe_ind "$(aoe_session_id "$WORKTREE_ROOT/$rel")" "$clean_sess_info")
      else
        org_project="${rel%/*}"
        label="${rel##*/}"
        sname="wrk-$(session_label "$(basename "$org_project")")__$(session_label "$label")"
        att=$(printf '%s\n' "$clean_sess_info" | awk -F'\t' -v s="$sname" '$1==s{print $2; exit}')
        if [ -z "$att" ]; then ind=' '
        elif [ "$att" -gt 0 ]; then ind='◆'
        else ind='◇'
        fi
      fi
      printf '%s\t%s %s\n' "$rel" "$ind" "$rel"
    done
  }

  if [ "${#merged[@]}" -gt 0 ]; then
    local selected
    selected=$(_clean_lines "${merged[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 \
            --preview "tree -C -L 1 $WORKTREE_ROOT/{1}" \
            --multi --bind 'load:select-all' \
            --prompt='Remove merged worktrees? ' \
            --header='TAB to deselect, ENTER to confirm  ◆ attached  ◇ detached' || true)
    while IFS= read -r line; do
      [ -n "$line" ] && to_remove+=("$(printf '%s' "$line" | cut -f1)")
    done <<< "$selected"
  fi

  if [ "${#unmerged[@]}" -gt 0 ]; then
    local extra
    extra=$(_clean_lines "${unmerged[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 \
            --preview "tree -C -L 1 $WORKTREE_ROOT/{1}" \
            --multi \
            --prompt='Also remove unmerged worktrees? ' \
            --header='TAB to select, ENTER to skip  ◆ attached  ◇ detached' || true)
    while IFS= read -r line; do
      [ -n "$line" ] && to_remove+=("$(printf '%s' "$line" | cut -f1)")
    done <<< "$extra"
  fi

  for rel in "${to_remove[@]+"${to_remove[@]}"}"; do
    local wt="$WORKTREE_ROOT/$rel"
    local org_project="${rel%/*}"
    local label="${rel##*/}"
    local source="$PROJECT_ROOT/$org_project"
    local branch
    branch=$(git -C "$wt" branch --show-current 2>/dev/null) || branch=''

    # Drop the aoe record first so its on_destroy hooks still see a live
    # worktree. --purge rather than the default trash: the worktree and branch
    # are about to go, so there is nothing left to restore the record to.
    # No --delete-worktree — wrk's worktrees are managed_by_aoe:false and the
    # removal below is wrk's to do.
    if has_aoe; then
      local aid
      # Every session rooted in this worktree, not just the first: a ctrl-t
      # session can sit alongside the branch session in the same directory, and
      # the directory is about to go.
      while IFS= read -r aid; do
        [ -n "$aid" ] && { aoe remove "$aid" --purge &>/dev/null || true; }
      done < <(aoe_sessions | awk -F'\t' -v p="$wt" '$1==p{print $2}')
    fi

    git -C "$source" worktree remove "$wt" 2>/dev/null \
      || git -C "$source" worktree remove --force "$wt"

    if [ -n "$branch" ]; then
      git -C "$source" branch -d "$branch" 2>/dev/null \
        || echo "Note: branch '$branch' not deleted (may have unmerged commits)"
    fi

    if ! has_aoe; then
      local sname="wrk-$(session_label "$(basename "$org_project")")__$(session_label "$label")"
      tmux kill-session -t "$sname" 2>/dev/null || true
    fi

    echo "Removed: $rel"
  done
}

# Handle subcommands before project discovery
case "${1:-}" in
  --help)    show_help; exit 0 ;;
  --version) echo "wrk $VERSION"; exit 0 ;;
  --list)    cmd_list;  exit 0 ;;
  --clean)   cmd_clean; exit 0 ;;
esac

sync_ssh_agent

# --- Project discovery ---

PROJECTS=()
for gitdir in "$PROJECT_ROOT"/*/*/.git; do
  [ -d "$gitdir" ] || continue
  PROJECTS+=( "${gitdir%/.git}" )
done

# Vault discovery (opt-in). Each WRK_VAULT_ROOTS entry is either a vault itself
# (contains the marker) or a folder scanned one level deep for vaults.
VAULTS=()
if [ -n "${WRK_VAULT_ROOTS:-}" ]; then
  IFS=':' read -r -a _roots <<< "$WRK_VAULT_ROOTS"
  for _root in "${_roots[@]}"; do
    [ -d "$_root" ] || continue
    if [ -e "$_root/$VAULT_MARKER" ]; then
      VAULTS+=( "${_root%/}" )
    else
      for _d in "$_root"/*/; do
        [ -e "${_d%/}/$VAULT_MARKER" ] && VAULTS+=( "${_d%/}" )
      done
    fi
  done
fi

[ "${#PROJECTS[@]}" -eq 0 ] && [ "${#VAULTS[@]}" -eq 0 ] && exit 0

# ◆ = session attached, ◇ = session detached, ' ' = no session
aoe_prime
_full_sess_info=$(tmux list-sessions \
  -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null || true)
_sess_all=() _sess_attached=()
while IFS=$'\t' read -r _sn _sa; do
  [[ "$_sn" == wrk-* ]] || continue
  _sess_all+=("$_sn")
  [[ "${_sa:-0}" -gt 0 ]] && _sess_attached+=("$_sn")
done <<< "$_full_sess_info"

_sess_match() {
  local base="$1" s; shift
  for s in "$@"; do [[ "$s" == "$base" || "$s" == "${base}__"* ]] && return 0; done
  return 1
}

# Picker rows carry: type \t abspath \t rel \t "<ind> display"
# (rel is empty for vaults; the indicator/display are the only shown field.)
_session_ind() {
  local base="$1"
  if _sess_match "$base" "${_sess_attached[@]+"${_sess_attached[@]}"}"; then
    printf '◆'
  elif _sess_match "$base" "${_sess_all[@]+"${_sess_all[@]}"}"; then
    printf '◇'
  else
    printf ' '
  fi
}

_project_lines=()
for _p in "${PROJECTS[@]+"${PROJECTS[@]}"}"; do
  _rel="${_p#"$PROJECT_ROOT"/}"
  if has_aoe; then
    _ind=$(aoe_project_ind "$_p" "$_rel" "$_full_sess_info")
  else
    _ind=$(_session_ind "wrk-$(session_label "${_p##*/}")")
  fi
  _project_lines+=("git"$'\t'"$_p"$'\t'"$_rel"$'\t'"$_ind $_rel")
done
for _v in "${VAULTS[@]+"${VAULTS[@]}"}"; do
  _name="${_v##*/}"
  if has_aoe; then
    _ind=$(aoe_project_ind "$_v" '' "$_full_sess_info")
  else
    _ind=$(_session_ind "wrk-vault-$(session_label "$_name")")
  fi
  _project_lines+=("vault"$'\t'"$_v"$'\t'$'\t'"$_ind 📓 $_name")
done

_fzf_result=$(printf '%s\n' "${_project_lines[@]}" \
  | fzf --delimiter=$'\t' --with-nth=4 \
        --preview 'tree -C -L 1 {2}' \
        --prompt='What do you want to work on? ' --query "${1:-}" \
        --expect=ctrl-o,ctrl-t,ctrl-x \
        --header='<C-o>: + worktree  <C-t>: + session  <C-x>: filter active  📓 vault')

[ -z "$_fzf_result" ] && exit 0

_fzf_key=$(printf '%s' "$_fzf_result" | head -1)
_fzf_line=$(printf '%s' "$_fzf_result" | tail -1)

if [ "$_fzf_key" = 'ctrl-x' ] && has_aoe; then
  _raw=$(aoe_sessions)
  if [ -z "$_raw" ]; then
    tmux display-message "No aoe sessions"
    exec "$0" "$@"
  fi
  _sess=$(while IFS=$'\t' read -r _p _id _t; do
      [ -z "$_id" ] && continue
      printf '%s\t%s %s\t%s\n' "$_id" "$(aoe_ind "$_id" "$_full_sess_info")" "$_t" "$_p"
    done <<< "$_raw" \
    | fzf --delimiter=$'\t' --with-nth=2 \
          --preview 'tree -C -L 1 {3}' \
          --prompt='Session: ' \
          --header='enter: attach') || true
  [ -z "$_sess" ] && exit 0
  aoe_attach "$(printf '%s' "$_sess" | cut -f1)"
fi

if [ "$_fzf_key" = 'ctrl-x' ]; then
  _raw=$(tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}'$'\t''#{session_path}' 2>/dev/null \
    | grep '^wrk-' || true)
  if [ -z "$_raw" ]; then
    tmux display-message "No active wrk sessions"
    exec "$0" "$@"
  fi
  _sess=$(printf '%s' "$_raw" \
    | awk -F'\t' '{ind=($2>0)?"◆":"◇"; printf "%s\t%s %s\t%s\n", $1, ind, $1, $3}' \
    | fzf --delimiter=$'\t' --with-nth=2 \
          --preview 'tree -C -L 1 {3}' \
          --prompt='Session: ' \
          --header='enter: attach') || true
  [ -z "$_sess" ] && exit 0
  _sname=$(printf '%s' "$_sess" | cut -f1)
  [ -L "$SSH_AUTH_SOCK_LINK" ] \
    && { tmux set-environment -t "$_sname" SSH_AUTH_SOCK "$SSH_AUTH_SOCK_LINK" 2>/dev/null || true; }
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$_sname"
  else
    tmux attach -d -t "$_sname"
  fi
  exit 0
fi

TYPE=$(printf '%s' "$_fzf_line" | cut -f1)
PROJECT_PATH=$(printf '%s' "$_fzf_line" | cut -f2)
PROJECT_REL=$(printf '%s' "$_fzf_line" | cut -f3)

[ -z "$PROJECT_PATH" ] && exit 0

# tmux-safe base name. Vaults use a distinct namespace so they never collide
# with a git repo of the same basename.
if [ "$TYPE" = 'vault' ]; then
  BASE="wrk-vault-$(session_label "$(basename "$PROJECT_PATH")")"
else
  BASE="wrk-$(session_label "$(basename "$PROJECT_PATH")")"
fi

# Determine session name and working directory
SESSION_DIR="$PROJECT_PATH"
SESSION="$BASE"

# aoe identity, carried alongside SESSION: <org> becomes the group, <repo> or
# <repo>-<label> the title, and AOE_BRANCH is set only for worktree sessions.
REPO="$(basename "$PROJECT_PATH")"
if [ "$TYPE" = 'vault' ]; then GROUP='vaults'; else GROUP="${PROJECT_REL%/*}"; fi
TITLE="$REPO"
AOE_BRANCH=''

if [ -n "${2:-}" ] && [ "$TYPE" = 'vault' ]; then
  SESSION="${BASE}__$(session_label "$2")"
  TITLE="$REPO-$(branch_name "$2")"
elif [ -n "${2:-}" ]; then
  BRANCH="$(branch_name "$2")"
  SESSION="${BASE}__$(session_label "$BRANCH")"
  SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
  TITLE="$REPO-$BRANCH"
  AOE_BRANCH="$BRANCH"
elif [ "$_fzf_key" = 'ctrl-o' ] && [ "$TYPE" != 'vault' ]; then
  raw_label=$(pick_branch "$PROJECT_PATH" "$PROJECT_REL") || exit 0
  [ -z "$raw_label" ] && exit 0
  BRANCH="$(branch_name "$raw_label")"
  SESSION="${BASE}__$(session_label "$BRANCH")"
  SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
  TITLE="$REPO-$BRANCH"
  AOE_BRANCH="$BRANCH"
elif [ "$_fzf_key" = 'ctrl-t' ]; then
  printf 'Session name: ' >&2
  read -r raw_label
  [ -z "$raw_label" ] && exit 0
  SESSION="${BASE}__$(session_label "$raw_label")"
  TITLE="$REPO-$(branch_name "$raw_label")"
elif has_aoe; then
  # Sub-picker over this project's aoe sessions — the project dir itself plus
  # anything under its worktree root. Picking one attaches and exits; the
  # sentinels fall through to creation below. With no existing sessions the
  # defaults set above open the project directly.
  _aoe_lines=() _aoe_titles=()
  while IFS=$'\t' read -r _p _id _t; do
    [ -z "$_id" ] && continue
    [ "$_p" = "$PROJECT_PATH" ] \
      || { [ -n "$PROJECT_REL" ] && [[ "$_p" == "$WORKTREE_ROOT/$PROJECT_REL/"* ]]; } \
      || continue
    _aoe_lines+=("$_id"$'\t'"$(aoe_ind "$_id" "$_full_sess_info") $_t")
    _aoe_titles+=("$_t")
  done <<< "$(aoe_sessions)"

  # Mirrors the fallback below: a lone default session opens straight through
  # rather than through a one-item picker.
  if [ "${#_aoe_lines[@]}" -gt 1 ] || \
     { [ "${#_aoe_lines[@]}" -eq 1 ] && [ "${_aoe_titles[0]}" != "$REPO" ]; }; then
    _aoe_lines+=('[new session]'$'\t''  [new session]')
    [ "$TYPE" != 'vault' ] && _aoe_lines+=('[new worktree]'$'\t''  [new worktree]')

    _pick=$(printf '%s\n' "${_aoe_lines[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 --preview '' --prompt='Session? ') || true
    [ -z "$_pick" ] && exit 0
    _pick=$(printf '%s' "$_pick" | cut -f1)
    case "$_pick" in
      '[new session]')
        printf 'Session name: '
        read -r raw_label
        [ -z "$raw_label" ] && exit 0
        TITLE="$REPO-$(branch_name "$raw_label")"
        ;;
      '[new worktree]')
        printf 'Session name: '
        read -r raw_label
        [ -z "$raw_label" ] && exit 0
        AOE_BRANCH="$(branch_name "$raw_label")"
        SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$AOE_BRANCH")"
        TITLE="$REPO-$AOE_BRANCH"
        ;;
      *) aoe_attach "$_pick" ;;
    esac
  fi
else
  # Find all existing sessions for this project (default + labeled)
  _sess_info=$(tmux list-sessions \
    -F '#{session_name}'$'\t''#{session_attached}' 2>/dev/null \
    | awk -F'\t' -v b="$BASE" '$1==b || index($1, b"__")==1' || true)

  SESSIONS=()
  while IFS= read -r s; do
    [ -n "$s" ] && SESSIONS+=("$s")
  done < <(printf '%s\n' "$_sess_info" | cut -f1)

  if [ "${#SESSIONS[@]}" -ge 2 ] || \
     { [ "${#SESSIONS[@]}" -eq 1 ] && [ "${SESSIONS[0]}" != "$BASE" ]; }; then
    _sess_lines=()
    _base_att=$(printf '%s\n' "$_sess_info" | awk -F'\t' -v n="$BASE" '$1==n{print $2; exit}')
    if [ "${_base_att:-0}" -gt 0 ]; then _ind='◆'
    elif [ -n "$_base_att" ]; then _ind='◇'
    else _ind=' '
    fi
    _sess_lines+=("$BASE"$'\t'"$_ind [default]")
    for _s in "${SESSIONS[@]}"; do
      [ "$_s" = "$BASE" ] && continue
      _att=$(printf '%s\n' "$_sess_info" | awk -F'\t' -v n="$_s" '$1==n{print $2; exit}')
      [ "${_att:-0}" -gt 0 ] && _ind='◆' || _ind='◇'
      _sess_lines+=("$_s"$'\t'"$_ind $_s")
    done
    _sess_lines+=('[new session]'$'\t''  [new session]')
    [ "$TYPE" != 'vault' ] && _sess_lines+=('[new worktree]'$'\t''  [new worktree]')

    SESSION=$(printf '%s\n' "${_sess_lines[@]}" \
      | fzf --delimiter=$'\t' --with-nth=2 --preview '' --prompt='Session? ') || true
    [ -z "$SESSION" ] && exit 0
    SESSION=$(printf '%s' "$SESSION" | cut -f1)
    if [ "$SESSION" = '[new session]' ]; then
      printf 'Session name: '
      read -r raw_label
      [ -z "$raw_label" ] && exit 0
      SESSION="${BASE}__$(session_label "$raw_label")"
    elif [ "$SESSION" = '[new worktree]' ]; then
      printf 'Session name: '
      read -r raw_label
      [ -z "$raw_label" ] && exit 0
      BRANCH="$(branch_name "$raw_label")"
      SESSION="${BASE}__$(session_label "$BRANCH")"
      SESSION_DIR="$(resolve_worktree "$PROJECT_PATH" "$PROJECT_REL" "$BRANCH")"
    fi
  else
    SESSION="$BASE"
  fi
fi

if [ "$TYPE" != 'vault' ] && command -v mise &>/dev/null \
   && [ "$SESSION_DIR" = "$PROJECT_PATH" ]; then
  mise trust "$SESSION_DIR" &>/dev/null
fi

# aoe owns session lifecycle when it is installed. It derives its own tmux name,
# sets allow-passthrough, and already uses switch-client when inside tmux, so
# none of the fallback plumbing below applies.
if has_aoe; then
  # Export the agent symlink so aoe's `environment = ["SSH_AUTH_SOCK"]`
  # passthrough forwards it into the pane. Passing it by name rather than as a
  # literal path keeps aoe's config free of any machine-specific value.
  [ -L "$SSH_AUTH_SOCK_LINK" ] && export SSH_AUTH_SOCK="$SSH_AUTH_SOCK_LINK"
  _aid=$(aoe_session_id "$SESSION_DIR" "$TITLE")
  if [ -n "$_aid" ]; then
    aoe_attach "$_aid"
  elif [ -n "$AOE_BRANCH" ]; then
    # No -b: resolve_worktree already created the worktree, so aoe adopts it as
    # managed_by_aoe:false and will never relocate or delete it.
    exec aoe add "$PROJECT_PATH" -w "$AOE_BRANCH" -t "$TITLE" -g "$GROUP" \
      --tool claude --trust-hooks -l
  else
    exec aoe add "$SESSION_DIR" -t "$TITLE" -g "$GROUP" --tool "$AOE_SHELL_TOOL" \
      --trust-hooks -l
  fi
fi

# Attach or create — use switch-client when already inside tmux.
# `=` prefix forces exact-name targeting; without it tmux falls back to prefix
# match and `wrk-foo` would resolve to an existing `wrk-foo__bar`.
tmux_attach() {
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "=$1"
  else
    tmux attach -d -t "=$1"
  fi
}

if tmux has-session -t "=$SESSION" 2>/dev/null; then
  [ -L "$SSH_AUTH_SOCK_LINK" ] \
    && { tmux set-environment -t "=$SESSION" SSH_AUTH_SOCK "$SSH_AUTH_SOCK_LINK" 2>/dev/null || true; }
  tmux_attach "$SESSION"
else
  [ -L "$SSH_AUTH_SOCK_LINK" ] && export SSH_AUTH_SOCK="$SSH_AUTH_SOCK_LINK"
  if [ -n "${TMUX:-}" ]; then
    tmux new-session -ds "$SESSION" -c "$SESSION_DIR"
    tmux set-option -t "=$SESSION" allow-passthrough on || true
    tmux switch-client -t "=$SESSION"
  else
    tmux new-session -s "$SESSION" -c "$SESSION_DIR"
    tmux set-option allow-passthrough on || true
  fi
fi
